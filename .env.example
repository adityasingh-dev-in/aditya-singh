# Required — Site
NEXT_PUBLIC_SITE_URL=https://aditya.dev

# Required — Admin Authentication
ADMIN_PASSWORD=your-strong-password-here
ADMIN_JWT_SECRET=your-random-256-bit-secret-here

# Required — GitHub (for publishing posts via the CMS)
GITHUB_PAT=ghp_your_personal_access_token
GITHUB_OWNER=adityasingh
GITHUB_REPO=aditya-singh
GITHUB_BRANCH=main

# Required — Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional — If using an unsigned upload preset:
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
